<taf-app:container:ghcr.io/taffish/somalier:0.3.5-r1$@[docker/podman: $(taf_somalier_hash() { if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1"; else shasum -a 256 "$1"; fi; }; taf_somalier_inventory_ok() { taf_somalier_list="$(awk -F '  ' 'length($1)!=64 || NF!=2 || substr($2,1,1)=="/" || $2 ~ /(^|\/)\.\.?($|\/)/ {bad=1} {print $2} END {exit bad}' "$taf_somalier_root/SHA256SUMS")" || return 1; test -z "$(awk -F '  ' '{print $1}' "$taf_somalier_root/SHA256SUMS" | tr -d 'a-f0-9\n')" || return 1; test -z "$(printf '%s\n' "$taf_somalier_list" | tr -d 'A-Za-z0-9_./+\n-')" || return 1; printf '%s\n' "$taf_somalier_list" | grep -Fx resource.json >/dev/null || return 1; taf_somalier_actual="$(cd "$taf_somalier_root" && find . -type f | sed 's|^\./||' | LC_ALL=C sort)"; taf_somalier_expected="$(printf '%s\n' "$taf_somalier_list" READY SHA256SUMS | LC_ALL=C sort)"; test "$taf_somalier_actual" = "$taf_somalier_expected" || return 1; test -z "$(cd "$taf_somalier_root" && find . -type l -print)" || return 1; taf_somalier_recorded="$(sed -n 's/^  "resource": "\(.*\)",$/\1/p' "$taf_somalier_root/resource.json")"; test -z "$(printf '%s' "$taf_somalier_recorded" | tr -d 'A-Za-z0-9_.-')" || return 1; if test "$taf_somalier_recorded" != 1kg-3479773; then test "${taf_somalier_recorded#local-}" != "$taf_somalier_recorded" && test -n "${taf_somalier_recorded#local-}" || return 1; fi; test -z "$taf_somalier_id" || test "$taf_somalier_recorded" = "$taf_somalier_id"; }; taf_somalier_emit() { taf_somalier_path="$(cd "$1" 2>/dev/null && pwd -P)"; taf_somalier_bad="$(printf '%s' "$taf_somalier_path" | tr -d 'A-Za-z0-9_./+-')"; if test -z "$taf_somalier_path" || test -n "$taf_somalier_bad"; then printf >&2 'taf-somalier: resource bind path must use letters, digits, _, ., /, + or -; use a safe physical path\n'; printf -- '--taffish-somalier-invalid-resource'; return; fi; printf -- '--volume=%s:%s' "$taf_somalier_path" "$2"; }; if test -n "${TAFFISH_SOMALIER_RESOURCE_INSTALL_ROOT:-}"; then taf_somalier_emit "$TAFFISH_SOMALIER_RESOURCE_INSTALL_ROOT" /resource-install; exit 0; fi; if test "${TAFFISH_SOMALIER_RESOURCE_AUTO_MOUNT:-1}" = 0; then exit 0; fi; taf_somalier_root="${TAFFISH_SOMALIER_RESOURCE_PATH:-}"; taf_somalier_id="${TAFFISH_SOMALIER_RESOURCE_ID:-}"; if test -z "$taf_somalier_root" && test -n "$taf_somalier_id"; then taf_somalier_bad="$(printf '%s' "$taf_somalier_id" | tr -d 'A-Za-z0-9_.-')"; if test -n "$taf_somalier_bad" || test "${taf_somalier_id#.}" != "$taf_somalier_id"; then printf -- '--taffish-somalier-invalid-resource'; exit 0; fi; for taf_somalier_candidate in "${TAFFISH_USER_HOME:-${HOME:-}/.local/share/taffish}/resources/somalier/$taf_somalier_id" "/usr/local/share/taffish/resources/somalier/$taf_somalier_id" "/opt/taffish/resources/somalier/$taf_somalier_id"; do if test -e "$taf_somalier_candidate"; then taf_somalier_root="$taf_somalier_candidate"; break; fi; done; fi; if test -n "$taf_somalier_root" || test -n "$taf_somalier_id"; then taf_somalier_valid=0; if test -f "$taf_somalier_root/READY" && test -f "$taf_somalier_root/SHA256SUMS" && test -f "$taf_somalier_root/resource.json"; then taf_somalier_sum="$(taf_somalier_hash "$taf_somalier_root/SHA256SUMS")"; if test "${taf_somalier_sum%% *}" = "$(cat "$taf_somalier_root/READY")" && grep -F '"schema": "taffish.somalier.resource.v1"' "$taf_somalier_root/resource.json" >/dev/null; then if (cd "$taf_somalier_root" && if command -v sha256sum >/dev/null 2>&1; then sha256sum -c SHA256SUMS; else shasum -a 256 -c SHA256SUMS; fi) >/dev/null 2>&1; then if taf_somalier_inventory_ok; then taf_somalier_valid=1; fi; fi; fi; fi; if test "$taf_somalier_valid" = 1; then taf_somalier_emit "$taf_somalier_root" /somalier-resource:ro; else printf >&2 'taf-somalier: selected resource missing or corrupt; run somalier-resources verify or choose TAFFISH_SOMALIER_RESOURCE_PATH\n'; printf -- '--taffish-somalier-invalid-resource'; fi; fi)][docker: --user=$(id -u):$(id -g)][podman: --userns=keep-id --user=$(id -u):$(id -g)][apptainer: $(taf_somalier_hash() { if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1"; else shasum -a 256 "$1"; fi; }; taf_somalier_inventory_ok() { taf_somalier_list="$(awk -F '  ' 'length($1)!=64 || NF!=2 || substr($2,1,1)=="/" || $2 ~ /(^|\/)\.\.?($|\/)/ {bad=1} {print $2} END {exit bad}' "$taf_somalier_root/SHA256SUMS")" || return 1; test -z "$(awk -F '  ' '{print $1}' "$taf_somalier_root/SHA256SUMS" | tr -d 'a-f0-9\n')" || return 1; test -z "$(printf '%s\n' "$taf_somalier_list" | tr -d 'A-Za-z0-9_./+\n-')" || return 1; printf '%s\n' "$taf_somalier_list" | grep -Fx resource.json >/dev/null || return 1; taf_somalier_actual="$(cd "$taf_somalier_root" && find . -type f | sed 's|^\./||' | LC_ALL=C sort)"; taf_somalier_expected="$(printf '%s\n' "$taf_somalier_list" READY SHA256SUMS | LC_ALL=C sort)"; test "$taf_somalier_actual" = "$taf_somalier_expected" || return 1; test -z "$(cd "$taf_somalier_root" && find . -type l -print)" || return 1; taf_somalier_recorded="$(sed -n 's/^  "resource": "\(.*\)",$/\1/p' "$taf_somalier_root/resource.json")"; test -z "$(printf '%s' "$taf_somalier_recorded" | tr -d 'A-Za-z0-9_.-')" || return 1; if test "$taf_somalier_recorded" != 1kg-3479773; then test "${taf_somalier_recorded#local-}" != "$taf_somalier_recorded" && test -n "${taf_somalier_recorded#local-}" || return 1; fi; test -z "$taf_somalier_id" || test "$taf_somalier_recorded" = "$taf_somalier_id"; }; taf_somalier_emit() { taf_somalier_path="$(cd "$1" 2>/dev/null && pwd -P)"; taf_somalier_bad="$(printf '%s' "$taf_somalier_path" | tr -d 'A-Za-z0-9_./+-')"; if test -z "$taf_somalier_path" || test -n "$taf_somalier_bad"; then printf >&2 'taf-somalier: resource bind path must use letters, digits, _, ., /, + or -; use a safe physical path\n'; printf -- '--taffish-somalier-invalid-resource'; return; fi; printf -- '--bind=%s:%s' "$taf_somalier_path" "$2"; }; if test -n "${TAFFISH_SOMALIER_RESOURCE_INSTALL_ROOT:-}"; then taf_somalier_emit "$TAFFISH_SOMALIER_RESOURCE_INSTALL_ROOT" /resource-install; exit 0; fi; if test "${TAFFISH_SOMALIER_RESOURCE_AUTO_MOUNT:-1}" = 0; then exit 0; fi; taf_somalier_root="${TAFFISH_SOMALIER_RESOURCE_PATH:-}"; taf_somalier_id="${TAFFISH_SOMALIER_RESOURCE_ID:-}"; if test -z "$taf_somalier_root" && test -n "$taf_somalier_id"; then taf_somalier_bad="$(printf '%s' "$taf_somalier_id" | tr -d 'A-Za-z0-9_.-')"; if test -n "$taf_somalier_bad" || test "${taf_somalier_id#.}" != "$taf_somalier_id"; then printf -- '--taffish-somalier-invalid-resource'; exit 0; fi; for taf_somalier_candidate in "${TAFFISH_USER_HOME:-${HOME:-}/.local/share/taffish}/resources/somalier/$taf_somalier_id" "/usr/local/share/taffish/resources/somalier/$taf_somalier_id" "/opt/taffish/resources/somalier/$taf_somalier_id"; do if test -e "$taf_somalier_candidate"; then taf_somalier_root="$taf_somalier_candidate"; break; fi; done; fi; if test -n "$taf_somalier_root" || test -n "$taf_somalier_id"; then taf_somalier_valid=0; if test -f "$taf_somalier_root/READY" && test -f "$taf_somalier_root/SHA256SUMS" && test -f "$taf_somalier_root/resource.json"; then taf_somalier_sum="$(taf_somalier_hash "$taf_somalier_root/SHA256SUMS")"; if test "${taf_somalier_sum%% *}" = "$(cat "$taf_somalier_root/READY")" && grep -F '"schema": "taffish.somalier.resource.v1"' "$taf_somalier_root/resource.json" >/dev/null; then if (cd "$taf_somalier_root" && if command -v sha256sum >/dev/null 2>&1; then sha256sum -c SHA256SUMS; else shasum -a 256 -c SHA256SUMS; fi) >/dev/null 2>&1; then if taf_somalier_inventory_ok; then taf_somalier_valid=1; fi; fi; fi; fi; if test "$taf_somalier_valid" = 1; then taf_somalier_emit "$taf_somalier_root" /somalier-resource:ro; else printf >&2 'taf-somalier: selected resource missing or corrupt; run somalier-resources verify or choose TAFFISH_SOMALIER_RESOURCE_PATH\n'; printf -- '--taffish-somalier-invalid-resource'; fi; fi)]>
somalier ::*ARGV*::
